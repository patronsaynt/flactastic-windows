{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLACtastic",
  "mainBinaryName": "flactastic",
  "identifier": "com.flactastic.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FLACtastic",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0E0E10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: flart: http://flart.localhost https: ; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "category": "Music",
    "copyright": "Copyright © 2026 FLACtastic. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "A music player for your FLAC library",
    "publisher": "FLACtastic",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libasound2",
          "libdbus-1-3"
        ],
        "desktopTemplate": "linux/flactastic.desktop"
      },
      "rpm": {
        "depends": [
          "alsa-lib",
          "dbus-libs"
        ],
        "desktopTemplate": "linux/flactastic.desktop"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "flac"
        ],
        "mimeType": "audio/flac",
        "name": "Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "mp3"
        ],
        "mimeType": "audio/mpeg",
        "name": "Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "m4a"
        ],
        "mimeType": "audio/mp4",
        "name": "Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "wav"
        ],
        "mimeType": "audio/wav",
        "name": "Audio File",
        "role": "Viewer"
      },
      {
        "ext": [
          "aiff",
          "aif"
        ],
        "mimeType": "audio/aiff",
        "name": "Audio File",
        "role": "Viewer"
      }
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "flactastic"
        ]
      }
    }
  }
}
