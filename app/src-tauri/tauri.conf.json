{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FLACtastic",
  "mainBinaryName": "flactastic",
  "identifier": "com.flactastic.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "beforeBuildCommand": "pnpm --dir ../ui build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FLACtastic",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 650,
        "decorations": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": true,
        "backgroundColor": "#0E0E10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: flart: http://flart.localhost https: ; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb", "rpm"],
    "category": "Music",
    "copyright": "Copyright © 2026 FLACtastic. All rights reserved.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "shortDescription": "A music player for your FLAC library",
    "fileAssociations": [
      { "ext": ["flac", "mp3", "m4a", "wav", "aiff", "aif"], "name": "Audio File", "role": "Viewer" }
    ]
  }
}
